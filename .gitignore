# Dependency directories
/node_modules/
/vendor/

# Environment configuration files - NEVER COMMIT THESE
/.env
/.env.*.local
/.env.local
/.env.production
.env.*.bak
.env.backup

# Storage logs and cache
/storage/*.key
/storage/logs/*
!/storage/logs/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore

# Bootstrap cache
/bootstrap/cache/*
!/bootstrap/cache/.gitignore

# Application cache
/var/cache/

# Testing files
/coverage/
.phpunit.result.cache
phpunit.result.cache

# Frontend build
/public/hot
/public/storage

# IDE files and editor configs
/.idea/
/.vscode/
!/.vscode/extensions.json
*.swp
*.swo
*.iml
.DS_Store

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Local development files
Homestead.json
Homestead.yaml
/.vagrant
.vagrant/
Vagrantfile
render.yaml

# Laravel specific
/.env.backup
/.env.testing
docker-compose.override.yml

# Database files (SQLite)
*.sqlite
*.sqlite3
/database/*.sqlite
/database/*.sqlite3

# Composer lock file (optional, usually committed for production dependencies)
# composer.lock

# NPM lock files (optional, usually committed for production dependencies)
# package-lock.json
# yarn.lock

# Temporary files
*.tmp
*.temp
*.bak
*~

# Local development databases
/storage/database.sqlite

# Local review notes
/issue.md
